//Write a function that prints 'Namaste' if user is Indian and Bonjour if the user is French.
#include <stdio.h>
//declaration/prototype
void Namaste();
void Bonjour();
int main(){
    printf("enter i for Indian and f for French:");
    char ch;
    scanf("%c",&ch);
    
    if(ch=='i'){
        Namaste();
    }else{
        Bonjour();
    }
    return 0;
}
//Function definition
void Namaste(){
    printf("Namaste\n");
}
void Bonjour(){
    printf("Bonjour");
}
