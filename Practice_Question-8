//Program to identify the case of an english alphabet
#include <stdio.h>
int main() {
    char ch;
    printf("enter character:");
    scanf("%c",&ch);
    if(ch>= 'A' && ch<='Z'){
        printf("ch is upper case");
    }else if(ch>='a' && ch<='z'){
        printf("ch is lower case");
    }else{
        printf("not an english letter");
    }
    return 0;
}
